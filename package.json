{
  "name": "dsh-pause-continue",
  "version": "1.0.0",
  "description": "Codex-style pause and continue for DeepSeek Harness: stop a running answer and resume from the break point. Modelled on Codex and Cursor. · Codex 式暂停与继续：在回答生成时暂停，并从断点接着生成。交互参考 Codex 与 Cursor。",
  "type": "module",
  "license": "MIT",
  "author": "yanweiyi11",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanweiyi11/dsh-pause-continue.git"
  },
  "homepage": "https://github.com/yanweiyi11/dsh-pause-continue",
  "bugs": {
    "url": "https://github.com/yanweiyi11/dsh-pause-continue/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "pause",
    "resume",
    "continue"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "pause-store.js",
    "rpc-channel.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "icon": "./icon.svg"
}
